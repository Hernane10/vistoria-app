# Copy this file to .env and keep these values (or replace with your own
# project's if you create a different one later).
#
# IMPORTANT: Vite only exposes env vars prefixed with VITE_ to the browser —
# the NEXT_PUBLIC_ prefix is a Next.js convention and does nothing here.
#
# These are the "anon" / "publishable" keys — safe to ship in the browser
# bundle by design. Security is enforced by Row Level Security policies in
# supabase/schema.sql, not by keeping this key secret. NEVER put a
# "service_role" key in a VITE_ variable — that one bypasses all security
# and must stay server-side only (e.g. as a Supabase Edge Function secret).

VITE_SUPABASE_URL=https://tskvzrbvtfypqjuzrdzh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_J3ut_dEopFdPCcMYbHjfFA_WweP6pHA
